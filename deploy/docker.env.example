# Compose interpolation template. Put real values in an untracked .env or shell environment.
# Local API-only smoke requires only JWT_HS256_SECRET. Worker profile also requires Vault and LLM values.

RPA_ENV=local
POSTGRES_DB=rpa
# Bootstrap-only PostgreSQL owner used by the postgres image and role-bootstrap.
# API/worker product evidence must use rpa_app below, not this role.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-local-postgres-password
POSTGRES_PORT=55432

# Runtime DB role split. rpa_app stays NOSUPERUSER/NOBYPASSRLS for API/worker
# evidence. rpa_lifecycle_bypass is a dedicated NOSUPERUSER/BYPASSRLS
# operational role for audited lifecycle/maintenance work only.
# compose applies db/roles.sql and injects LOGIN passwords during role-bootstrap.
# Do not rename the users unless db/roles.sql is updated in the same change.
RPA_MIGRATOR_DB_USER=rpa_migrator
RPA_MIGRATOR_DB_PASSWORD=replace-local-migrator-password
RPA_APP_DB_USER=rpa_app
RPA_APP_DB_PASSWORD=replace-local-app-password
RPA_LIFECYCLE_BYPASS_DB_USER=rpa_lifecycle_bypass
RPA_LIFECYCLE_BYPASS_DB_PASSWORD=replace-local-lifecycle-bypass-password

RPA_API_PORT=8080
RPA_HEALTH_PORT=8081
JWT_HS256_SECRET=replace-with-at-least-32-characters
SIGNED_COMMAND_REGISTRY_MODE=deny_all
API_LOG_LEVEL=info
# Allowed: none, console, prometheus, otlp. prometheus exposes health /metrics.
OTEL_EXPORTER=console
# Required only when OTEL_EXPORTER=otlp. Do not include credentials, query, or fragments.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Worker profile
WORKER_ID=10000000-0000-4000-8000-0000000000aa
ARTIFACT_LIFECYCLE_WORKER_ID=20000000-0000-4000-8000-0000000000aa
WORKER_POOL_KEYS=
MAINTENANCE_TENANT_IDS=
GRAPHILE_CONCURRENCY=1
BROWSER_HEADLESS=true

CODEX_BASE_URL=
CODEX_API_KEY=
CODEX_MODEL=

VAULT_ADDR=
VAULT_MOUNT=secret
VAULT_RUNTIME_WORKER_ROLE_ID=
VAULT_RUNTIME_WORKER_SECRET_ID=

VISUAL_EVIDENCE_VIDEO_ENABLED=false
